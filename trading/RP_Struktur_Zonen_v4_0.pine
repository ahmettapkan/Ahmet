//@version=6
// ============================================================================
// RP Struktur & Zonen v4.0.2  –  Blueprint 701 als Setup-Lebenszyklus
//
// Phase 1 (Kern). Aufbau entlang der Pre-Trade-Checkliste des Blueprints:
//   Schritt 1  Bias: Daily + 4H bestimmen die Richtung, 1H liefert Kontext und Suchzone.
//              Eine laufende 1H-Wende blockiert nicht, nur eine bestätigte Gegenwende.
//              v4.0.1/2: Eine laufende Wende (↓? / ↑?) zählt als Richtung, wenn der nächsthöhere
//              oder der nächsttiefere Zeitrahmen bestätigt in dieselbe Richtung zeigt.
//   v4.0.2: Zonenkontakt wird je Richtung der 1H-Struktur gespeichert, unabhängig vom Bias.
//           Erscheint der Bias erst nach dem CHoCH, zählt ein Bruch der letzten N Kerzen nach.
//   Schritt 2  Struktur im Chart (BOS / CHoCH) mit derselben Funktion wie der Bias.
//              Gegen den Trend zählt nur ein Schluss jenseits des Impulsursprungs (Fib 1).
//   Schritt 3  Suchzone: Fib 0,5–1 des 1H-Impulses und/oder frische Demand/Supply (1H, 15M).
//   Schritt 4  Confluence an der Suchzone: Demand/Supply, PDH/PDL, Asia, VWAP, FVG.
//   Schritt 5  Kontakt: Preis in der Zone, Kontakt gilt N Kerzen.
//   Schritt 6  Bestätigung: CHoCH im 1–5M aus der Zone heraus, Mindest-Impuls, ADX,
//              optional Abgriff, Umkehrmuster, CVD-Divergenz.
//   Schritt 7  Zeit: Handelsfenster London / New York, News-Sperre.
//   Schritt 8  Plan: Entry 0,71 | SL Fib 1 | TP, CRV >= 1:3, Tages- und Wochenlimit in R.
//
// Setup-Lebenszyklus (jede Änderung mit Grund im Dashboard):
//   0 KEIN SETUP -> 1 WARTEN -> 2 KONTAKT -> 3 BESTÄTIGT -> 4 BEREIT -> 5 AKTIV -> 6 BEENDET
//
// Dashboard = Checkliste des Skills "setup-check-701" (8 Zeilen mit Status), dazu Phase,
// Qualität, Trade-Plan, Limits und virtuelle Statistik. Alarme in festem Feldformat.
// Phase 2 (geplant): Setup-Typ 15M-Limit, Positionsgröße in Lots, Korrelationshinweis.
// Phase 3 (geplant): AMD-Kontext (Accumulation / Manipulation / Distribution), Journal-Export.
// ============================================================================
indicator("RP Struktur & Zonen v4", shorttitle = "RP4", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 300, max_bars_back = 2000)

// ---------------------------------------------------------------- Eingaben
grpPre     = "Markt-Preset"
presetSel  = input.string("Automatisch", "Preset", options = ["Automatisch", "Gold", "Silber", "Öl", "Nasdaq", "EUR/USD", "GBP/USD", "Dow Jones", "DAX", "Bitcoin", "Solana", "Manuell"], group = grpPre, tooltip = "Automatisch erkennt den Markt am Symbol und setzt ADX-Mindestwert, Asia-Anzeige und ★-Zonenpflicht. Manuell = Werte aus den Gruppen unten.")
autoSwing  = input.bool(true, "Swing-Länge automatisch (bis 5M: 3, sonst 5)", group = grpPre)
autoAlerts = input.bool(true, "Alarm-Profil automatisch nach Zeitrahmen", group = grpPre, tooltip = "Bis 5M: CHoCH + Setup bereit. Ab 15M: Bias-Wechsel, Zonen, Fib. Im 15M zusätzlich Setup bereit.")

grp1     = "Schritt 1 · Bias (höhere Zeitrahmen)"
tfD      = input.timeframe("D",   "Zeitrahmen Richtung 1", group = grp1)
tf4      = input.timeframe("240", "Zeitrahmen Richtung 2", group = grp1)
tfH      = input.timeframe("60",  "Zeitrahmen Kontext / Suchzone", group = grp1)
swLenD   = input.int(3, "Swing-Länge Richtung 1 (Daily)", minval = 2, group = grp1)
swLen4   = input.int(5, "Swing-Länge Richtung 2 (4H)", minval = 2, group = grp1)
swLenH   = input.int(5, "Swing-Länge Kontext (1H)", minval = 2, group = grp1)
biasMode = input.string("Daily + 4H", "Bias gilt, wenn", options = ["Daily + 4H", "Daily + 4H + 1H", "Nur Daily"], group = grp1, tooltip = "Blueprint: Daily, 4H und 1H einheitlich. v4 nutzt den 1H als Kontext: eine laufende 1H-Wende (Rücksetzer) blockiert nicht, eine bestätigte 1H-Gegenwende schon (Schalter unten).")
htfBlock = input.bool(true, "Bestätigte 1H-Gegenwende blockiert den Bias", group = grp1)
pendOk   = input.bool(true, "Laufende Wende zählt, wenn ein Nachbar-Zeitrahmen sie bestätigt", group = grp1, tooltip = "4H ↓? zählt als ↓, wenn Daily oder 1H bestätigt abwärts sind. Daily ↓? zählt als ↓, wenn der 4H (bestätigt oder nach dieser Regel) abwärts ist. Ohne diese Regel blockiert eine laufende Wende den Bias oft stundenlang, bis das tiefere Hoch per Swing bestätigt ist. Aus = Verhalten v3.x.")
protHtf  = input.bool(true, "Wende nur unter Fib 1 (geschütztes Tief/Hoch)", group = grp1, tooltip = "Gegen den Trend zählt nur ein Schluss jenseits des Impulsursprungs. Zwischentiefs im Rücksetzer kippen weder Bias noch Suchzone. Aus = Verhalten v3.8.")
showFlip = input.bool(true, "Kipp-Level im Dashboard", group = grp1)

grp2       = "Schritt 2 · Struktur im Chart"
swLenIn    = input.int(5, "Swing-Länge (manuell)", minval = 2, group = grp2)
showStr    = input.bool(true, "BOS / CHoCH anzeigen", group = grp2)
showSweepX = input.bool(true, "Liquiditätsabgriff (X) markieren", group = grp2)
protChart  = input.bool(true, "Chart ab 15M: CHoCH nur gegen geschütztes Hoch/Tief", group = grp2, tooltip = "Im 1–5M-Entry-Chart bleibt der frühe CHoCH am letzten Swing (Blueprint Schritt 6).")

grp3        = "Schritt 3 · Suchzone"
zoneGate    = input.string("Fib oder Demand/Supply", "Suchzone ist", options = ["Fib oder Demand/Supply", "Fib und Demand/Supply", "nur Fib 0,5–1", "nur Demand/Supply"], group = grp3)
fibA        = input.float(0.5, "Fib-Zone beginnt bei", step = 0.01, group = grp3)
showZones   = input.bool(true, "Demand / Supply anzeigen", group = grp3)
use15Zones  = input.bool(true, "15M-Zonen zusätzlich (Charts bis 15M)", group = grp3)
showZonesLtf = input.bool(true, "Zonen auch im 1–5M anzeigen", group = grp3)
sdImp       = input.float(1.5, "Mindest-Impuls aus der Zone (x ATR des Zonen-Zeitrahmens)", minval = 0, step = 0.1, group = grp3)
maxZones    = input.int(6, "Max. aktive Zonen je Seite", minval = 1, maxval = 20, group = grp3)
onlySweepIn = input.bool(false, "Nur Zonen nach Liquiditätsabgriff (★)", group = grp3)
onlyFresh   = input.bool(true, "Nur ungetestete Zonen zählen", group = grp3)
showPD      = input.bool(true, "Vortageshoch / -tief (PDH / PDL)", group = grp3)
showAsiaIn  = input.bool(true, "Asia-Session Hoch / Tief", group = grp3)
asiaSess    = input.session("0100-0900", "Asia-Session", group = grp3)
asiaTz      = input.string("Europe/Berlin", "Zeitzone Asia-Session", group = grp3)
useVwap     = input.bool(true, "Tages-VWAP als Confluence", group = grp3)
showVwap    = input.bool(true, "VWAP anzeigen", group = grp3)
useFvg      = input.bool(true, "Fair Value Gaps als Confluence", group = grp3)
showFvg     = input.bool(true, "FVG anzeigen", group = grp3)
fvgMin      = input.float(0.1, "FVG-Mindestgröße (x ATR)", minval = 0, step = 0.05, group = grp3)

grp4     = "Schritt 4 · Confluence & Qualität"
minConf  = input.int(1, "Mindest-Faktoren neben Fib", minval = 0, maxval = 5, group = grp4, tooltip = "Blueprint: mindestens zwei Faktoren. 1 = Fib + ein weiterer (Demand/Supply, PDH/PDL, Asia, VWAP, FVG). Im Entry-Chart wird an der 1H-Suchzone gemessen.")
minGrade = input.string("C", "Mindest-Setup-Qualität", options = ["C", "B", "A"], group = grp4, tooltip = "Punkte (max. 6): Abgriff, ★-Zone, 2+ Faktoren, 3+ Faktoren, Umkehrmuster, CVD-Divergenz. A = 4–6, B = 2–3, C = 0–1.")
usePat   = input.bool(true, "Umkehrmuster am Impulsursprung prüfen", group = grp4)
pinRatio = input.float(2.0, "Pin-Bar: Docht mind. x Körper", minval = 1, step = 0.1, group = grp4)
useCvd   = input.bool(true, "CVD-Divergenz prüfen", group = grp4)
cvdSrc   = input.string("Intrabar", "CVD-Quelle", options = ["Intrabar", "Kerzen-Schätzung"], group = grp4)

grp5     = "Schritt 5 · Kontakt"
useHtfZone = input.bool(true, "Entry-Chart: CHoCH nur nach Kontakt mit der Suchzone", group = grp5)
htfLook  = input.int(40, "Kontakt gilt für (Kerzen im Entry-Chart)", minval = 1, group = grp5, tooltip = "3M-Chart: 40 Kerzen = 2 Stunden.")
useOrigin = input.bool(true, "Impuls muss in der Suchzone starten", group = grp5)

grp6     = "Schritt 6 · Bestätigung"
minImp   = input.float(2.0, "Mindest-Impuls des CHoCH (x ATR)", minval = 0, step = 0.1, group = grp6)
useSide  = input.bool(true, "Seitwärtsfilter (ADX im Kontext-Zeitrahmen)", group = grp6)
adxLen   = input.int(14, "ADX-Länge", minval = 1, group = grp6)
adxMinIn = input.int(20, "ADX-Mindestwert (nur Preset Manuell)", minval = 1, group = grp6)
reqSweep = input.bool(false, "Liquiditätsabgriff ist Pflicht", group = grp6)
reqPatIn = input.bool(false, "Umkehrmuster ist Pflicht", group = grp6)
reqCvd   = input.bool(false, "CVD-Divergenz ist Pflicht", group = grp6)
maxWait  = input.int(40, "Setup verfällt nach (Kerzen ohne Entry)", minval = 0, group = grp6)

grp7     = "Schritt 7 · Zeit"
useWin   = input.bool(true, "Nur in den Handelsfenstern (Charts bis 15M)", group = grp7)
winAName = input.string("London", "Name Fenster 1", group = grp7)
winA     = input.session("0900-1100:23456", "Fenster 1", group = grp7)
winBName = input.string("New York", "Name Fenster 2", group = grp7)
winB     = input.session("1430-1700:23456", "Fenster 2", group = grp7)
winTz    = input.string("Europe/Berlin", "Zeitzone der Fenster", group = grp7)
useNews  = input.bool(true, "NFP (1. Freitag 08:30 NY) und EIA-Öl (Mi 10:30 NY) sperren", group = grp7)
newsPad  = input.int(15, "Sperre ± Minuten", minval = 0, maxval = 120, group = grp7)
useCust  = input.bool(false, "Eigene Sperrzeit aktiv (z. B. CPI, Fed)", group = grp7)
custSess = input.session("1415-1445", "Eigene Sperrzeit", group = grp7)
custTz   = input.string("Europe/Berlin", "Zeitzone eigene Sperrzeit", group = grp7)

grp8     = "Schritt 8 · Trade-Plan & Risiko"
showFib  = input.bool(true, "Fibonacci des CHoCH-Impulses zeichnen", group = grp8)
fibB     = input.float(0.71,  "Entry-Level", step = 0.01, group = grp8)
fibTP    = input.float(-0.17, "Take-Profit-Extension", step = 0.01, group = grp8)
slBuf    = input.float(0.0, "SL-Puffer (x ATR)", minval = 0, step = 0.05, group = grp8)
tpMode   = input.string("Fib-Extension", "Take-Profit", options = ["Fib-Extension", "CRV fix"], group = grp8)
crvT     = input.float(3.0, "CRV-Ziel", minval = 1, step = 0.1, group = grp8)
reqCrv   = input.bool(true, "CRV-Ziel ist Pflicht", group = grp8)
dayLimR  = input.float(2.0, "Tageslimit (R, 0 = aus)", minval = 0, step = 0.5, group = grp8, tooltip = "Blueprint: nach −2 R am Tag keine neuen Setups.")
weekLimR = input.float(5.0, "Wochenlimit (R, 0 = aus)", minval = 0, step = 0.5, group = grp8, tooltip = "Blueprint: nach −5 R in der Woche keine neuen Setups.")
showPlan = input.bool(true, "Entry / SL / TP beschriften", group = grp8)

grpAl      = "Alarme (ein Alarm für alles)"
alBiasIn   = input.bool(true,  "Bias-Wechsel", group = grpAl)
alChochIn  = input.bool(true,  "CHoCH aus der Suchzone (Phase BESTÄTIGT)", group = grpAl)
alZoneIn   = input.bool(true,  "Suchzone erreicht (Phase KONTAKT)", group = grpAl)
alReadyIn  = input.bool(true,  "Setup bereit (Limit-Order setzen)", group = grpAl)
alPhase    = input.bool(false, "Jeder Phasenwechsel", group = grpAl)
alTrade    = input.bool(false, "Virtueller Trade: Entry / TP / SL", group = grpAl)

grpSt      = "Statistik"
showStat   = input.bool(true, "Virtuelle Statistik im Dashboard", group = grpSt)
